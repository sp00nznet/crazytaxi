.idea/

# OS files
Thumbs.db
.DS_Store

# Temporary analysis files
*.tmp
build/smoke_test.log

# Recompiled game source. This is a machine translation of the game's own
# executable - a derivative of it - so it is not distributed here. Generate it
# from your own copy of the disc: see the build steps in README.md.
src/game/
include/game/

# Python bytecode
__pycache__/
*.pyc
